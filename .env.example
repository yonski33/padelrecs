# Server-only: Supabase shared Session pooler URI (port 5432); never prefix with NEXT_PUBLIC_.
DATABASE_URL=
# New verified PadelRecs Supabase project ref; must match deployment/targets.json.
SUPABASE_PROJECT_REF=
# Optional direct/session connection for migrations and imports (otherwise DATABASE_URL).
MIGRATION_DATABASE_URL=
# Supabase project Settings > API / Connect dialog. Publishable key is safe for browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated Supabase Auth user UUIDs, configured after creating your admin user.
ADMIN_USER_IDS=
# Exact origin used for auth callbacks and POST-origin checks. No trailing slash.
SITE_URL=http://localhost:3000
# Additional exact trusted origins, comma-separated; no wildcards.
SITE_ALLOWED_ORIGINS=
# Shared secret for POST /api/revalidate, which refreshes the cached public pages after a script changes data
# (publish-web-reviews, import). Same value in every site's Vercel project (Production) and in your local .env.local.
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=
