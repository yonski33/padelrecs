{
  "name": "padelrecs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:import": "tsx --env-file-if-exists=.env.local scripts/import-data.ts",
    "db:verify": "tsx --env-file-if-exists=.env.local scripts/verify-data.ts",
    "db:check-export": "tsx --env-file-if-exists=.env.local scripts/check-export.ts",
    "db:export": "tsx --env-file-if-exists=.env.local scripts/export-data.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.0.0",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "postgres": "^3.4.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "sharp": "0.35.5",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  }
}
